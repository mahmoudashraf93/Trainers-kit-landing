layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<url><loc>{{ '/' | absolute_url | xml_escape }}</loc></url>
<url><loc>{{ '/blog/' | absolute_url | xml_escape }}</loc></url>
<url><loc>{{ '/changelog.html' | absolute_url | xml_escape }}</loc></url>
{% for item in site.pages %}<url><loc>{{ item.url | absolute_url | xml_escape }}</loc></url>{% endfor %}
{% for post in site.posts %}<url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>{% endfor %}
</urlset>
